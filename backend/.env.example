LLM_API_KEY=your_key_here
LLM_PROVIDER=mock
LLM_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
DEBUG=True

# Self-consistency metric (extended scope): how many independent samples to
# re-generate per answer, and at what temperature. Uncomment to override
# the defaults (3 samples, temperature 0.8).
# SELF_CONSISTENCY_SAMPLES=3
# SELF_CONSISTENCY_TEMPERATURE=0.8
